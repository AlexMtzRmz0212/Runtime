# Notion: create an internal integration at https://www.notion.so/profile/integrations
# and share BOTH databases below with it (… menu > Connections).
NOTION_TOKEN=
# The "TV Shows" database (the id is the 32-character part of its URL).
SHOWS_DATABASE_ID=
# An empty database called "Episodes". The app adds its own columns on first load.
EPISODES_DATABASE_ID=

# Password gate for the owner tools + secret used to sign the session cookie.
APP_PASSWORD=
SESSION_SECRET=

# Only for `npm run migrate`: a token from the OTHER Notion account that holds the per-show databases.
SOURCE_NOTION_TOKEN=
